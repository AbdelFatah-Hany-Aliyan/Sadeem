// Sadeem Studio — Database Schema
// Phase 4.2: PostgreSQL & Prisma ORM Foundation

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Core Domain Enums
// -----------------------------------------------------------------------------

enum DevelopmentStatus {
  CONCEPT
  MVP
  BUILDING
  LIVE
  MAINTENANCE
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProjectType {
  MOBILE_APPLICATION
  WEB_PLATFORM
  COLLABORATIVE_COMMERCE
  ENTERPRISE_SYSTEM
  OTHER
}

enum OwnershipType {
  SADEEM_VENTURE
  SADEEM_SYSTEM
  COLLABORATIVE_PARTNERSHIP
  CLIENT_SYSTEM
}

enum PartnershipStatus {
  NOT_APPLICABLE
  UNDER_DISCUSSION
  CONFIRMED
  DISSOLVED
}

enum TechCategory {
  FRONTEND
  BACKEND
  MOBILE
  AI_ML
  DATABASE
  INFRASTRUCTURE
  OTHER
}

enum MediaType {
  COVER_IMAGE
  SCREENSHOT
  DIAGRAM
  LOGO
  VIDEO
}

enum InquiryType {
  BUSINESS_SYSTEM
  VENTURE_PITCH
  PARTNERSHIP
  GENERAL
}

enum InquiryStatus {
  NEW
  REVIEWING
  RESPONDED
  ARCHIVED
}

enum AdminRole {
  SUPER_ADMIN
  EDITOR
  VIEWER
}

// -----------------------------------------------------------------------------
// Project & Portfolio Models
// -----------------------------------------------------------------------------

model Project {
  id                String             @id @default(cuid())
  slug              String             @unique
  type              ProjectType
  developmentStatus DevelopmentStatus  @default(BUILDING)
  publicationStatus PublicationStatus  @default(DRAFT)
  ownershipType     OwnershipType
  sadeemRole        String
  partnershipStatus PartnershipStatus  @default(NOT_APPLICABLE)
  featured          Boolean            @default(false)
  displayOrder      Int                @default(0)
  accentColor       String?
  year              Int?

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  publishedAt       DateTime?

  // Relations
  translations      ProjectTranslation[]
  features          ProjectFeature[]
  technologies      ProjectTechnology[]
  media             ProjectMedia[]

  @@index([slug])
  @@index([publicationStatus])
  @@index([developmentStatus])
  @@index([featured, displayOrder])
}

model ProjectTranslation {
  id               String   @id @default(cuid())
  projectId        String
  locale           String   // e.g. "en", "ar"
  
  title            String
  tagline          String?
  categoryName     String
  shortDescription String   @db.Text
  fullDescription  String   @db.Text
  
  problem          String?  @db.Text
  solution         String?  @db.Text
  roleDescription  String?  @db.Text
  
  seoTitle         String?
  seoDescription   String?  @db.Text

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, locale])
  @@index([locale])
}

model ProjectFeature {
  id           String                      @id @default(cuid())
  projectId    String
  displayOrder Int                         @default(0)
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt

  project      Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  translations ProjectFeatureTranslation[]

  @@index([projectId, displayOrder])
}

model ProjectFeatureTranslation {
  id          String         @id @default(cuid())
  featureId   String
  locale      String         // "en", "ar"
  title       String
  description String?        @db.Text

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  feature     ProjectFeature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([featureId, locale])
  @@index([locale])
}

model Technology {
  id          String              @id @default(cuid())
  slug        String              @unique
  name        String
  category    TechCategory        @default(OTHER)
  icon        String?
  description String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  projects    ProjectTechnology[]

  @@index([slug])
  @@index([category])
}

model ProjectTechnology {
  projectId    String
  technologyId String
  isCore       Boolean    @default(false)
  displayOrder Int        @default(0)

  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  technology   Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@id([projectId, technologyId])
  @@index([technologyId])
}

model ProjectMedia {
  id           String                    @id @default(cuid())
  projectId    String
  mediaType    MediaType                 @default(SCREENSHOT)
  storageKey   String                    // S3/R2/GCS key or asset path
  mimeType     String?
  width        Int?
  height       Int?
  sizeBytes    BigInt?
  displayOrder Int                       @default(0)
  
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  project      Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  translations ProjectMediaTranslation[]

  @@index([projectId, displayOrder])
}

model ProjectMediaTranslation {
  id        String       @id @default(cuid())
  mediaId   String
  locale    String       // "en", "ar"
  altText   String?
  caption   String?

  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  media     ProjectMedia @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([mediaId, locale])
  @@index([locale])
}

// -----------------------------------------------------------------------------
// Structured Content Management Models
// -----------------------------------------------------------------------------

model ContentSection {
  id           String               @id @default(cuid())
  sectionKey   String               @unique // e.g. "hero", "capabilities", "dual_engine", "about"
  description  String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  translations ContentTranslation[]

  @@index([sectionKey])
}

model ContentTranslation {
  id          String         @id @default(cuid())
  sectionId   String
  locale      String         // "en", "ar"
  content     Json           // Structured JSON matching section schema

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  section     ContentSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([sectionId, locale])
  @@index([locale])
}

model SiteSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   @db.Text
  description String?
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key])
}

// -----------------------------------------------------------------------------
// Inquiries & Studio CRM
// -----------------------------------------------------------------------------

model Inquiry {
  id          String        @id @default(cuid())
  name        String
  email       String
  company     String?
  inquiryType InquiryType   @default(GENERAL)
  message     String        @db.Text
  status      InquiryStatus @default(NEW)
  ipAddress   String?

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
}

// -----------------------------------------------------------------------------
// Administrative Foundation & Audit Log
// -----------------------------------------------------------------------------

model AdminUser {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  role         AdminRole  @default(EDITOR)
  isActive     Boolean    @default(true)
  lastLoginAt  DateTime?

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  auditLogs    AuditLog[]

  @@index([email])
}

model AuditLog {
  id         String     @id @default(cuid())
  userId     String?
  action     String     // e.g. "PROJECT_CREATE", "PROJECT_UPDATE", "SETTING_UPDATE"
  entityType String     // e.g. "Project", "SiteSetting"
  entityId   String?
  details    Json?
  createdAt  DateTime   @default(now())

  user       AdminUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
}
