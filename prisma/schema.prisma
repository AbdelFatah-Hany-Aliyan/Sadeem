// Sadeem Studio — Database Schema
// Phase 4.2: PostgreSQL & Prisma ORM Foundation

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -----------------------------------------------------------------------------
// Core Domain Enums
// -----------------------------------------------------------------------------

enum DevelopmentStatus {
  CONCEPT
  MVP
  BUILDING
  LIVE
  MAINTENANCE
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProjectType {
  MOBILE_APPLICATION
  WEB_PLATFORM
  COLLABORATIVE_COMMERCE
  ENTERPRISE_SYSTEM
  OTHER
}

enum OwnershipType {
  SADEEM_VENTURE
  SADEEM_SYSTEM
  COLLABORATIVE_PARTNERSHIP
  CLIENT_SYSTEM
}

enum PartnershipStatus {
  NOT_APPLICABLE
  UNDER_DISCUSSION
  CONFIRMED
  DISSOLVED
}

enum TechCategory {
  FRONTEND
  BACKEND
  MOBILE
  AI_ML
  DATABASE
  INFRASTRUCTURE
  OTHER
}

enum MediaType {
  COVER_IMAGE
  SCREENSHOT
  DIAGRAM
  LOGO
  VIDEO
}

enum InquiryType {
  BUSINESS_PROJECT
  VENTURE_PITCH
  BUSINESS_SYSTEM
  PARTNERSHIP
  GENERAL
}

enum InquiryStatus {
  NEW
  REVIEWING
  QUALIFIED
  DISCOVERY
  PROPOSAL
  ACCEPTED
  REJECTED
  CLOSED
  RESPONDED
  ARCHIVED
}

enum ContactChannel {
  EMAIL
  PHONE
  WHATSAPP
}

enum VentureStage {
  IDEA
  RESEARCH
  PROTOTYPE
  MVP
  EXISTING_PRODUCT
}

enum ProjectCategory {
  ENTERPRISE_SYSTEM
  WEB_PLATFORM
  MOBILE_APPLICATION
  ECOSYSTEM_INTEGRATION
  OTHER
}

enum ExpectedTimeline {
  IMMEDIATE
  ONE_TO_THREE_MONTHS
  THREE_TO_SIX_MONTHS
  FLEXIBLE
}

enum BudgetRange {
  LESS_THAN_10K
  TEN_TO_25K
  TWENTY_FIVE_TO_50K
  FIFTY_K_PLUS
  UNDISCLOSED
}

enum AdminRole {
  SUPER_ADMIN
  EDITOR
  VIEWER
}

// -----------------------------------------------------------------------------
// Project & Portfolio Models
// -----------------------------------------------------------------------------

model Project {
  id                String             @id @default(cuid())
  slug              String             @unique
  type              ProjectType
  developmentStatus DevelopmentStatus  @default(BUILDING)
  publicationStatus PublicationStatus  @default(DRAFT)
  ownershipType     OwnershipType
  sadeemRole        String
  partnershipStatus PartnershipStatus  @default(NOT_APPLICABLE)
  featured          Boolean            @default(false)
  displayOrder      Int                @default(0)
  accentColor       String?
  year              Int?

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  publishedAt       DateTime?

  // Relations
  translations      ProjectTranslation[]
  features          ProjectFeature[]
  technologies      ProjectTechnology[]
  media             ProjectMedia[]

  @@index([slug])
  @@index([publicationStatus])
  @@index([developmentStatus])
  @@index([featured, displayOrder])
}

model ProjectTranslation {
  id               String   @id @default(cuid())
  projectId        String
  locale           String   // e.g. "en", "ar"
  
  title            String
  tagline          String?
  categoryName     String
  shortDescription String   @db.Text
  fullDescription  String   @db.Text
  
  problem          String?  @db.Text
  solution         String?  @db.Text
  roleDescription  String?  @db.Text
  
  seoTitle         String?
  seoDescription   String?  @db.Text

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, locale])
  @@index([locale])
}

model ProjectFeature {
  id           String                      @id @default(cuid())
  projectId    String
  displayOrder Int                         @default(0)
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt

  project      Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  translations ProjectFeatureTranslation[]

  @@index([projectId, displayOrder])
}

model ProjectFeatureTranslation {
  id          String         @id @default(cuid())
  featureId   String
  locale      String         // "en", "ar"
  title       String
  description String?        @db.Text

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  feature     ProjectFeature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([featureId, locale])
  @@index([locale])
}

model Technology {
  id          String              @id @default(cuid())
  slug        String              @unique
  name        String
  category    TechCategory        @default(OTHER)
  icon        String?
  description String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  projects    ProjectTechnology[]

  @@index([slug])
  @@index([category])
}

model ProjectTechnology {
  projectId    String
  technologyId String
  isCore       Boolean    @default(false)
  displayOrder Int        @default(0)

  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  technology   Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@id([projectId, technologyId])
  @@index([technologyId])
}

model ProjectMedia {
  id               String                    @id @default(cuid())
  projectId        String?
  mediaType        MediaType                 @default(SCREENSHOT)
  storageKey       String                    // S3/R2/GCS key or asset path
  publicUrl        String?
  originalFilename String?
  mimeType         String?
  width            Int?
  height           Int?
  sizeBytes        BigInt?
  displayOrder     Int                       @default(0)
  isCover          Boolean                   @default(false)
  uploadedBy       String?
  
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  project          Project?                  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  translations     ProjectMediaTranslation[]

  @@index([projectId, displayOrder])
  @@index([mediaType])
  @@index([storageKey])
}

model ProjectMediaTranslation {
  id        String       @id @default(cuid())
  mediaId   String
  locale    String       // "en", "ar"
  altText   String?
  caption   String?

  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  media     ProjectMedia @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([mediaId, locale])
  @@index([locale])
}

// -----------------------------------------------------------------------------
// Structured Content Management Models
// -----------------------------------------------------------------------------

model ContentSection {
  id           String               @id @default(cuid())
  sectionKey   String               @unique // e.g. "hero", "capabilities", "dual_engine", "about"
  name         String?
  description  String?
  status       PublicationStatus    @default(DRAFT)
  publishedAt  DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  translations ContentTranslation[]

  @@index([sectionKey])
  @@index([status])
}

model ContentTranslation {
  id               String            @id @default(cuid())
  sectionId        String
  locale           String            // "en", "ar"
  status           PublicationStatus @default(DRAFT)
  draftContent     Json              // Active draft edited in admin
  publishedContent Json?             // Approved published content visible to public
  publishedAt      DateTime?
  publishedBy      String?
  updatedBy        String?

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  section          ContentSection    @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([sectionId, locale])
  @@index([locale])
  @@index([status])
}

model SiteSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   @db.Text
  description String?
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key])
}

// -----------------------------------------------------------------------------
// Inquiries & Studio CRM
// -----------------------------------------------------------------------------

model Inquiry {
  id                  String            @id @default(cuid())
  inquiryType         InquiryType       @default(GENERAL)
  status              InquiryStatus     @default(NEW)
  
  // Submitter details
  name                String
  email               String
  company             String?
  contactChannel      ContactChannel    @default(EMAIL)
  phoneOrHandle       String?
  locale              String            @default("en") // "en", "ar"

  // Business Project specific fields (Path A: Start a Project)
  projectCategory     ProjectCategory?
  problemStatement    String?           @db.Text
  desiredOutcome      String?           @db.Text
  expectedTimeline    ExpectedTimeline?
  budgetRange         BudgetRange?      @default(UNDISCLOSED)

  // Venture Pitch specific fields (Path B: Pitch an Idea)
  ideaName            String?
  targetAudience      String?           @db.Text
  ventureStage        VentureStage?
  founderExpertise    String?           @db.Text
  expectedInvolvement String?           @db.Text
  existingResources   String?           @db.Text

  // Common message / notes
  message             String?           @db.Text
  sourceRoute         String?           // e.g. "/start-project", "/pitch-idea", "/#contact"

  // Privacy & Consent Record
  consentGiven        Boolean           @default(true)
  consentVersion      String            @default("v1.0-2026")
  consentGivenAt      DateTime          @default(now())
  ipAddress           String?

  // Internal CRM / Administrative management (strictly separated from public content)
  internalNotes       String?           @db.Text
  assignedToId        String?
  assignedTo          AdminUser?        @relation("AssignedInquiries", fields: [assignedToId], references: [id], onDelete: SetNull)
  reviewedAt          DateTime?
  closedAt            DateTime?
  followUpDate        DateTime?

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([inquiryType])
  @@index([status])
  @@index([email])
  @@index([assignedToId])
  @@index([createdAt])
}

// -----------------------------------------------------------------------------
// Administrative Foundation & Audit Log
// -----------------------------------------------------------------------------

model AdminUser {
  id                 String         @id @default(cuid())
  email              String         @unique
  passwordHash       String
  name               String
  role               AdminRole      @default(EDITOR)
  isActive           Boolean        @default(true)
  tokenVersion       Int            @default(1)
  lastLoginAt        DateTime?

  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  auditLogs          AuditLog[]
  revokedTokens      RevokedToken[]
  assignedInquiries  Inquiry[]      @relation("AssignedInquiries")

  @@index([email])
}

model RevokedToken {
  id        String     @id @default(cuid())
  jti       String     @unique
  userId    String?
  reason    String?    // e.g. "LOGOUT", "REVOCATION"
  expiresAt DateTime
  createdAt DateTime   @default(now())

  user      AdminUser? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([jti])
  @@index([expiresAt])
}

model AuditLog {
  id         String     @id @default(cuid())
  userId     String?
  action     String     // e.g. "PROJECT_CREATE", "PROJECT_UPDATE", "SETTING_UPDATE"
  entityType String     // e.g. "Project", "SiteSetting"
  entityId   String?
  details    Json?
  createdAt  DateTime   @default(now())

  user       AdminUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
}
