# Sadeem Studio — Environment Variables Template
# Phase 4.10: Staging & Production Configuration

# -----------------------------------------------------------------------------
# 1. Database Connections (PostgreSQL / Neon)
# -----------------------------------------------------------------------------
# Pooled connection string used at runtime by Prisma Client (e.g. Neon PgBouncer pooler)
DATABASE_URL="postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/sadeem_staging?sslmode=require&pgbouncer=true"

# Direct connection string used for Prisma CLI migrations (bypasses pooler for advisory locks)
DIRECT_URL="postgresql://username:password@ep-sample.us-east-2.aws.neon.tech/sadeem_staging?sslmode=require"

# -----------------------------------------------------------------------------
# 2. Application & Authentication Security
# -----------------------------------------------------------------------------
# Mandatory 32+ character cryptographically secure secret for JWT session tokens
AUTH_SECRET=""

# Application runtime environment: "development", "test", or "production"
NODE_ENV="production"

# Public canonical URL of the deployment
NEXT_PUBLIC_SITE_URL="https://staging.sadeem.studio"

# -----------------------------------------------------------------------------
# 3. Distributed Rate Limiting (Upstash Redis)
# -----------------------------------------------------------------------------
# Required for shared rate-limiting across serverless/clustered instances
UPSTASH_REDIS_REST_URL="https://sample.upstash.io"
UPSTASH_REDIS_REST_TOKEN="replace-with-upstash-rest-token"
# Optional fallback standard Redis URL if self-hosting
# REDIS_URL="rediss://default:token@sample.upstash.io:6379"

# -----------------------------------------------------------------------------
# 4. Media Storage (Cloudflare R2 / AWS S3)
# -----------------------------------------------------------------------------
# Direct media uploads remain safely disabled if unconfigured
STORAGE_PROVIDER="r2"
STORAGE_BUCKET="sadeem-media-staging"
STORAGE_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
STORAGE_ACCESS_KEY_ID="replace-with-r2-access-key-id"
STORAGE_SECRET_ACCESS_KEY="replace-with-r2-secret-access-key"
STORAGE_PUBLIC_URL="https://media-staging.sadeem.studio"

# Optional: untrusted SVGs are strictly rejected by default in production.
# ALLOW_UNTRUSTED_SVG="false"

# -----------------------------------------------------------------------------
# 5. Transactional Email (Resend)
# -----------------------------------------------------------------------------
# Leave empty to safely queue/block real sending in offline/unconfigured environments
RESEND_API_KEY=""
EMAIL_FROM=""
NEXT_PUBLIC_APP_URL=""


